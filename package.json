{
  "name": "cognito-local",
  "version": "0.0.0-dev",
  "license": "MIT",
  "type": "module",
  "bin": "lib/bin/start.js",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc --emitDeclarationOnly --project tsconfig.build.json && esbuild $(find src -name '*.ts' ! -name '*.test.ts' ! -path '*/__tests__/*') --outdir=lib --platform=node --target=node24 --format=cjs && cp -r src/keys lib/keys",
    "lint": "biome check --write",
    "start": "COGNITO_LOCAL_DEVMODE=1 tsx src/bin/start.ts",
    "start:debug": "COGNITO_LOCAL_DEVMODE=1 DEBUG=1 tsx --inspect-brk src/bin/start.ts",
    "start:watch": "nodemon",
    "test": "vitest",
    "type-check": "tsc --target es2024 --moduleResolution bundler --esModuleInterop --resolveJsonModule --strict --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@types/aws-lambda": "^8.10.159",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.mergewith": "^4.6.9",
    "@types/node": "^25.2.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "4.0.18",
    "esbuild": "^0.27.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "markdown-toc": "^1.2.0",
    "nodemon": "^3.1.11",
    "pino-test": "^1.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@aws-crypto/client-node": "^4.2.1",
    "@aws-sdk/client-cognito-identity-provider": "^3.981.0",
    "@aws-sdk/client-kms": "^3.981.0",
    "@aws-sdk/client-lambda": "^3.981.0",
    "body-parser": "^2.2.1",
    "boxen": "^8.0.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "lodash.mergewith": "^4.6.2",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "short-uuid": "^6.0.3",
    "stormdb": "^0.6.0",
    "uuid": "^13.0.0"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "yarn start"
  },
  "lint-staged": {
    "*.ts": [
      "biome check --write",
      "tsc --target es2024 --moduleResolution bundler --esModuleInterop --resolveJsonModule --strict --noEmit"
    ],
    "README.md": "markdown-toc -i --bullets=- --maxdepth=3"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lankalana/cognito-local.git"
  }
}
