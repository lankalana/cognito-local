{
  "name": "cognito-local",
  "version": "0.0.0-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lankalana/cognito-local.git"
  },
  "bin": "lib/start.js",
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "vite build --outDir lib --target node24 --minify",
    "format": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "start": "COGNITO_LOCAL_DEVMODE=1 tsx src/bin/start.ts",
    "start:debug": "COGNITO_LOCAL_DEVMODE=1 DEBUG=1 tsx --inspect-brk src/bin/start.ts",
    "start:watch": "nodemon",
    "test": "vitest",
    "test:unit-test": "vitest --run --dir src",
    "test:integration-test": "vitest --run --dir integration-tests",
    "type-check": "tsc --target es2024 --moduleResolution bundler --esModuleInterop --resolveJsonModule --strict --noEmit",
    "validate": "aube run type-check && aube test --run",
    "auto-upgrade": "npm-check-updates --doctor --doctorInstall 'aube install' --doctorTest 'aube run validate' -u",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-crypto/client-node": "5.0.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1086.0",
    "@aws-sdk/client-kms": "3.1086.0",
    "@aws-sdk/client-lambda": "3.1086.0",
    "body-parser": "2.3.0",
    "boxen": "8.0.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "lodash.mergewith": "4.6.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "short-uuid": "6.0.3",
    "stormdb": "0.6.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "@types/body-parser": "1.19.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash.mergewith": "4.6.9",
    "@types/ms": "2.1.0",
    "@types/node": "26.1.1",
    "@types/supertest": "7.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "markdown-toc": "1.2.0",
    "nodemon": "3.1.14",
    "oxfmt": "0.58.0",
    "oxlint": "^1.74.0",
    "pino-test": "2.0.0",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "^8.1.4",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "oxfmt",
      "tsc --target es2024 --moduleResolution bundler --esModuleInterop --resolveJsonModule --strict --noEmit"
    ],
    "README.md": "markdown-toc -i --bullets=- --maxdepth=3"
  },
  "nodemonConfig": {
    "exec": "yarn start",
    "ext": "ts",
    "ignore": [
      "**/*.test.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "aube": {
    "allowBuilds": {
      "oxfmt": true,
      "oxlint": true,
      "esbuild": true
    }
  }
}
